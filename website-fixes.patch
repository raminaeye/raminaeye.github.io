+      assignStep();
       renderLegend();
       draw(); updateStats();
     }
diff --git a/nas.html b/nas.html
index 429ecf7..ec68617 100644
--- a/nas.html
+++ b/nas.html
@@ -190,6 +190,27 @@
       text-align: center; margin-top: 0.8rem; font-size: 0.95em; color: #2c3e50;
     }
     .demo-stats strong { color: #2980b9; }
+    /* Paper-figure hotspot tours (DARTS Fig 1, NASNet Fig 1) */
+    .nas-hotspot {
+      width: 30px; height: 30px; border-radius: 50%;
+      background: #2c3e50; color: #fff; border: 2px solid #fff;
+      font-size: 14px; font-weight: bold; cursor: pointer; padding: 0;
+      box-shadow: 0 1px 4px rgba(0,0,0,0.35);
+    }
