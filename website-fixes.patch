diff --git a/kmeans.html b/kmeans.html
index d4ec531..fb471b8 100644
--- a/kmeans.html
+++ b/kmeans.html
@@ -545,6 +545,10 @@
       assign = [];
       for (var i = 0; i < pts.length; i++) assign.push(-1);
       iter = 0; phase = 'assign'; converged = false;
+      /* First paint must show the meaningful clustered state, not a gray
+         unassigned frame: assign every point to its nearest random-start
